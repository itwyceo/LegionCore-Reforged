###################################################################################################

###################################################################################################
# ANTICHEAT
#
#    Anticheat.Enable
#        Enables/disables the anticheat system.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Anticheat.Enable = 0

#
#    Anticheat.ReportsForIngameWarnings
#        Number of reports needed before GMs are notified in game.
#        Default: 70

Anticheat.ReportsForIngameWarnings = 70

#
#    Anticheat.DetectionsEnabled
#        Bitmask of the enabled detections:
#        SPEED_HACK            = 1
#        FLY_HACK              = 2
#        WALK_WATER_HACK       = 4
#        JUMP_HACK             = 8
#        TELEPORT_PLANE_HACK   = 16
#        CLIMB_HACK            = 32
#        Default: 31 - (Everything except climb)

Anticheat.DetectionsEnabled = 1

#
#    Anticheat.MaxReportsForDailyReport
#        Number of reports needed to store a daily report in the DB.
#        Default: 70

Anticheat.MaxReportsForDailyReport = 70

#
# MOVEMENT ANTICHEAT
#

Anticheat.AntiMultiJump.Enable = 0
Anticheat.AntiSpeedHack.Enable = 0
Anticheat.AntiSpeedHack.UseInterpolation = 0
Anticheat.AntiWallClimb.Enable = 0
Anticheat.AntiWaterWalk.Enable = 0
Anticheat.GMAnnounceMask = 0
Anticheat.MaxAllowedDesync = 0
Anticheat.NotifyCheaters = 0
Anticheat.Detail.Log = 0

# DB debug log for testing
Anticheat.LogData        = 0

#
#    Anticheat.DryRun
#        Detect and report, never punish. Kicks and bans are logged as what they would have
#        been. Leave this on until the detection log shows nothing but real cheating.
#        Default: 1 - (report only)
#                 0 - (apply the sanctions from cheat_sanctions)
#
#    Anticheat.SpeedTolerance
#        Multiplier on the distance a client may cover between two movement packets. Network
#        jitter alone routinely reaches twenty percent, while a speed hack is worth several
#        hundred, so a wide margin costs almost nothing in detection.
#        Default: 1.35
#
#    Anticheat.TeleportDistance
#        Yards a client may move in a single packet before it counts as a teleport. Elevators,
#        falls and lag spikes live below this; a teleport hack is worth hundreds of yards.
#        Default: 60
#
#    Anticheat.DistanceMargin
#        Flat yard margin added to the allowed distance.
#        Default: 2

Anticheat.DryRun = 1
Anticheat.SpeedTolerance = 1.35
Anticheat.TeleportDistance = 60
Anticheat.DistanceMargin = 2

#
###################################################################################################

###################################################################################################
# WARDEN
#
#    Warden.Enabled
#        Enables the Warden anticheat system (client memory checks).
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Warden.Enabled = 0

#
#    WardenExtended.Enabled
#        Enables the extended anticheat system (additional checks).
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

WardenExtended.Enabled = 0

#
#    Warden.BasicSecurityLevelReq
#        Security level below which basic checks are sent.
#        Default: 40

Warden.BasicSecurityLevelReq = 40

#
#    Warden.MaxSecurityLevelReq
#        Security level below which advanced checks are sent.
#        Default: 100

Warden.MaxSecurityLevelReq = 100

#
#    Warden.ClientResponseDelay
#        Time (in milliseconds) before a client that does not respond is disconnected.
#        Default: 60000 - (1 minute)

Warden.ClientResponseDelay = 60000

#
#    Warden.ClientCheckHoldOff
#        Time (in milliseconds) between two check requests sent to the client.
#        A low value increases traffic and load on the client and server side.
#        Default: 25000 - (25 seconds)

Warden.ClientCheckHoldOff = 25000

#
###################################################################################################

###################################################################################################
# SQL UPDATES
#
#    Updates.EnableDatabases
#        Bitmask of the databases to update automatically.
#        DATABASE_LOGIN     = 1  (auth database)
#        DATABASE_CHARACTER = 2  (characters database)
#        DATABASE_WORLD     = 4  (world database)
#        DATABASE_HOTFIX    = 8  (hotfixes database)
#        Default: 15 - (All enabled)
#                 4  - (World only)
#                 0  - (All disabled)

Updates.EnableDatabases = 15

#
#    Updates.AutoSetup
#        Automatically populates empty databases at first startup.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Updates.AutoSetup = 1

#
#    Updates.Redundancy
#        Checks the hashes of already applied updates to detect changes
#        and reapplies them if needed.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Updates.Redundancy = 1

#
#    Updates.ArchivedRedundancy
#        Checks the hashes of archived updates (slows down startup).
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Updates.ArchivedRedundancy = 0

#
#    Updates.AllowRehash
#        Inserts the current file hash in the database if it is missing.
#        Useful to mark a file as applied without knowing its hash.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Updates.AllowRehash = 1

#
#    Updates.CleanDeadRefMaxCount
#        Cleans orphaned references if an update was renamed or removed.
#        Only runs if the number of missing references is lower than or equal
#        to this value (protects against accidentally erasing the update history).
#        Default: 3  - (Enabled)
#                 0  - (Disabled)
#                -1  - (Enabled, unlimited)

Updates.CleanDeadRefMaxCount = 3

#
###################################################################################################

###################################################################################################
# HOTSWAP (dynamic script reloading)
#
#    HotSwap.Enabled
#        Enables dynamic script reloading (requires DYNAMIC_LINKING=1 at compile time).
#        Automatically reloads modified scripts.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

HotSwap.Enabled = 1

#
#    HotSwap.ScriptDir
#        Directory containing the script shared libraries (.dll/.so).
#        Default: "scripts"

HotSwap.ScriptDir = "scripts"

#
#    HotSwap.EnableReCompiler
#        Enables the dynamic script recompiler.
#        Watches the source directories and recompiles modified modules.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

HotSwap.EnableReCompiler = 1

#
#    HotSwap.EnableEarlyTermination
#        Stops the build of a module if an associated source file
#        was changed in the meantime.
#        Default: 1 - (Enabled)

HotSwap.EnableEarlyTermination = 1

#
#    HotSwap.EnableBuildFileRecreation
#        Recreates the build files when sources are added or removed.
#        Default: 1 - (Enabled)

HotSwap.EnableBuildFileRecreation = 1

#
#    HotSwap.EnableInstall
#        Runs cmake install after automatic builds.
#        Default: 1 - (Enabled)

HotSwap.EnableInstall = 1

#
#    HotSwap.EnablePrefixCorrection
#        Automatically sets CMAKE_INSTALL_PREFIX to the current location
#        of the binary in the filesystem.
#        Default: 1 - (Enabled)

HotSwap.EnablePrefixCorrection = 1

#
#    HotSwap.ReCompilerBuildType
#        Build type of the automatic builds.
#        Default: ""        - (Built-in build type of the module)
#                 "Release" - (Release builds only)
#                 "Debug"   - (Debug builds only)

HotSwap.ReCompilerBuildType = ""

#
###################################################################################################

###################################################################################################
# LOG CONFIG
#
#    LogDB.Opt.ClearInterval
#        Time (in minutes) of the timer that clears old entries from the `logs` table.
#        Default: 10

LogDB.Opt.ClearInterval = 10

#
#    LogDB.Opt.ClearTime
#        Time (in seconds) old entries are kept in the `logs` table.
#        Default: 1209600 - (14 days)
#                 0       - (Disabled, never delete)

LogDB.Opt.ClearTime = 1209600

#
#    PacketLogFile
#        Binary log file of the network packets.
#        The file extension must be .pkt to be parsable by WowPacketParser.
#        Example: "World.pkt"
#        Default: "" - (Disabled)

PacketLogFile = ""

#
#  Appender config (log destinations):
#    Appender.name
#        Format: Type,LogLevel,Flags,optional1,optional2,optional3
#
#        Type:
#            0 - None
#            1 - Console
#            2 - File
#            3 - Database
#
#        LogLevel:
#            0 - Disabled
#            1 - Trace
#            2 - Debug
#            3 - Info
#            4 - Warn
#            5 - Error
#            6 - Fatal
#
#        Flags:
#            0  - None
#            1  - Prefix timestamp to the text
#            2  - Prefix log level to the text
#            4  - Prefix log filter type to the text
#            8  - Append timestamp to the log file name (YYYY-MM-DD_HH-MM-SS, Type=2)
#            16 - Make a backup of the existing file before overwriting it (Mode=w)
#
#        Colors (optional1 if Type=Console):
#            Format: "fatal error warn info debug trace"
#            0-BLACK/1-RED/2-GREEN/3-BROWN/4-BLUE/5-MAGENTA/6-CYAN/7-GREY
#            8-YELLOW/9-LRED/10-LGREEN/11-LBLUE/12-LMAGENTA/13-LCYAN/14-WHITE
#
#        File    (optional1 if Type=File): File name ("%s" for dynamic file names)
#        Mode    (optional2 if Type=File): a=Append, w=Overwrite
#        MaxSize (optional3 if Type=File): Maximum size in bytes (max 4 GB, 0=unlimited)
#

Appender.Console=1,3,0
Appender.Server=2,2,0,Server.log,w
Appender.GM=2,2,15,gm/gm_%s.log
Appender.DBErrors=2,2,0,DBErrors.log
Appender.Anticheat=2,3,0,Anticheat.log

#  Logger config (what to log):
#    Logger.name
#        Format: LogLevel,AppenderList
#
#        LogLevel: 0=Disabled, 1=Trace, 2=Debug, 3=Info, 4=Warn, 5=Error, 6=Fatal
#        AppenderList: Appenders linked to this logger (separated by spaces)
#

Logger.root=5,Console Server
Logger.server=3,Console Server
Logger.commands.gm=3,Console GM
Logger.scripts.hotswap=3,Console Server
Logger.sql.sql=5,Console DBErrors
Logger.sql.updates=3,Console Server
Logger.mmaps=3,Server
#Logger.anticheat=3,Anticheat

