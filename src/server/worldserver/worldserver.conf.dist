###################################################################################################

###################################################################################################
# BLACK MARKET
#
#    BlackMarket.Enabled
#        Enables/disables the Black Market.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

BlackMarket.Enabled = 0

#
#    BlackMarket.MaxAuctions
#        Maximum number of simultaneous auctions on the Black Market.
#        Default: 12

BlackMarket.MaxAuctions = 12

#
#    BlackMarket.UpdatePeriod
#        Time (in hours) between renewals of the Black Market auctions.
#        Default: 24

BlackMarket.UpdatePeriod = 24

