###################################################
# LegionCore World Server configuration file      #
###################################################
[worldserver]

###################################################################################################
# GAME VERSION
#
#    Game.Build.Version
#        Supported WoW Legion 7.3.5 client build.
#        Must be the same in bnetserver.conf and worldserver.conf.
#
#        Available builds: 26124, 26365, 26654, 26822, 26899, 26972
#        Default: 26124

Game.Build.Version = 26972

#
#    Game.Patch
#        Active Legion content tier. Each patch is its own tier: it drives the currencies, the
#        item level caps, the Artifact Knowledge cap, and the quests and zones of each tier (see
#        Game.Patch.ContentScripts). Raids do not depend on it: they open with the RAID OPENING
#        section.
#            1 - 7.0    The Emerald Nightmare
#            2 - 7.1    Trial of Valor
#            3 - 7.1.5  The Nighthold
#            4 - 7.2    Tomb of Sargeras / Broken Shore
#            5 - 7.3    Antorus / Argus  (all of 7.3.5)
#        Default: 5

Game.Patch = 5

#
#    Game.Patch.ContentScripts
#        At startup, when Game.Patch has changed, the server runs the SQL files
#        enable-patch-*/disable-patch-*-content.sql of sql/optional by itself: the quests and
#        zones of the tiers above Game.Patch are closed, the others open. A file only runs when
#        the tier changes, not at every startup.
#        A player logging in inside a closed zone is sent to Stormwind or Orgrimmar.
#            1 - enabled
#            0 - disabled: run the files by hand
#        Default: 1

Game.Patch.ContentScripts = 1

#
#    Legionfall.ContributionsRequired
#        Number of contributions (100 War Supplies each) needed to build a Broken Shore building:
#        Mage Tower, Command Center, Nether Disruptor. On retail a whole region contributed; the
#        value should follow the population of the server. Each building is built on its own.
#        Cycle, from the client data: building, active 2 days, under attack 1 day, destroyed 1
#        day, then building again. Nothing moves below tier 7.2.
#        GM commands: .legionfall info, state, progress.
#        Default: 200
#
#    Legionfall.MageTower.AlwaysBuilt
#        1 keeps the Mage Tower built for good, as Blizzard did in June 2018: its challenges stay
#        open. The two other buildings still follow their cycle.
#        Default: 0

Legionfall.ContributionsRequired = 200
Legionfall.MageTower.AlwaysBuilt = 0

#
#    Timewalking.Enable
#        Timewalking weeks (The Burning Crusade, Wrath of the Lich King, Cataclysm and Mists of
#        Pandaria dungeons). 0 keeps their events from starting: queues, Archmage Timear's weekly
#        quests and vendors.
#        Default: 1
#
#    Timewalking.Interval
#        One Timewalking week every N weeks, the expansions taking turns in release order. A week
#        starts at the weekly reset (WeeklyReset.Day / .Hour).
#        Default: 1 (every week)

Timewalking.Enable = 1
Timewalking.Interval = 1

#
#    Custom.GnomereganRun.Months / Custom.GnomereganRun.Days
#        Great Gnomeregan Run: one race every N months from midnight on the 14th of October, lasting
#        N days. 12 and 1 are Blizzard's dates, those of the client's calendar; any other value makes
#        the calendar show the realm's own dates.
#        Default: 12 and 1

Custom.GnomereganRun.Months = 12
Custom.GnomereganRun.Days = 1

#
#    Custom.ItemLevel.Catchup.Enable
#        Item level catch-up.
#            0 - Loot uses the original item levels of the content tier set by Game.Patch
#                (ItemLevel.* values below). A normal dungeon can no longer outclass the
#                first raid.
#            1 - Loot uses the 7.3.5 values frozen in the client DB2 files, that is the
#                catch-up raises Blizzard applied at the end of the expansion.
#        Default: 0

Custom.ItemLevel.Catchup.Enable = 0

#
#    Custom.ItemLevel.DungeonTier
#        Content tier whose dungeon item levels the client is shown, and hands out.
#        Blizzard raised dungeon rewards over the expansion to keep them a catch-up path:
#        805/825/840 for normal, heroic and mythic at launch, against 845/865/885 by 7.3.
#        The client reads those numbers from ItemLevelSelector, so on a realm running an
#        earlier tier the Adventure Guide promises rewards that never come.
#        This is deliberately its own setting, NOT tied to Game.Patch: a realm can open 7.3
#        content while still handing out launch rewards.
#              0   leave the client data alone (7.3 values, 845/865/885)
#              1   7.0    805 / 825 / 840
#              2   7.1    same as 7.0
#              3   7.1.5  same as 7.0
#              4   7.2    805 / 825 / 845: the mythic takes one step, then stays
#              5   7.3    same as 7.2
#        Raids are untouched: their values are per tier and were never inflated. Karazhan
#        keeps its own levels (850/855/870).
#        Default: 0 - leave the client data alone

Custom.ItemLevel.DungeonTier = 0

#
#    Custom.LegionInvasions.Enable
#        Legion Assaults on the Broken Isles (7.2 content).
#        Independent from Game.Patch: turn the event on or off whenever you want.
#        Default: 0

Custom.LegionInvasions.Enable = 0

#
#    Custom.DemonInvasionPrepatch.Enable
#        Demon invasions on Azeroth (Eastern Kingdoms and Kalimdor), the event that
#        preceded the Legion launch. Custom code, unrelated to Game.Patch.
#        Default: 0

Custom.DemonInvasionPrepatch.Enable = 0

#
#    Custom.ArgusInSky.Enable
#        Draws the planet Argus in the sky over Azeroth, as patch 7.3 did. The client holds
#        every piece needed but never evaluates them on its own: the server has to send
#        SMSG_UPDATE_CELESTIAL_BODY, which this option turns on. Which body is drawn is then
#        decided client side from the MapCelestialBody rows and their player conditions.
#        Independent from Game.Patch.
#        Default: 0 - off

Custom.ArgusInSky.Enable = 0

#
#    Custom.SilithusWound.Default
#        Which Silithus a player arrives in.
#        1 opens the journey. Everyone arrives in the Wound, the zone as patch 7.3 left it with
#        the sword planted, and Zidormi offers the one line that leads elsewhere: the past to
#        whoever stands in the present, the way home to whoever stands in the past.
#        0 closes it. She has nothing to say and the zone stays as the patch left it.
#        A marker already taken is never removed on its own - not on leaving the zone, changing
#        map or logging out - except when the journey is closed, which hands it back on entering.
#        Default: 1 - the sword is planted

Custom.SilithusWound.Default = 1

#
#    Artifact.Knowledge.BookLoot.Raids
#        Raids where the Knowledge book can drop, as a bitmask. Add the values you want:
#             1  The Emerald Nightmare      (7.0)
#             2  Trial of Valor             (7.1)
#             4  The Nighthold              (7.1.5)
#             8  Tomb of Sargeras           (7.2)
#            16  Antorus, the Burning Throne (7.3)
#
#        Examples: 1 = Emerald Nightmare only, 3 = first two raids,
#                  31 = all five, 0 = no raid at all.
#        Has no effect while Artifact.Knowledge.BookLoot.Enable is 0.
#        Default: 31

Artifact.Knowledge.BookLoot.Raids = 31

#
#    ItemLevel.Dungeon.Normal / Heroic / Mythic
#    ItemLevel.MythicPlus.Base
#        Item level of Legion dungeon loot: 805 / 825 / 840 up to 7.1.5, then the mythic takes
#        one step to 845 with 7.2 and stays there. Dungeons stay a permanent entry ramp, only
#        raids move gear from one tier to the next.
#        Mythic+ base (+2 and +3 = base + 5, chest + 10): 840 at every tier, so a +2 gives 845,
#        at least a mythic 0.
#
#        Raid loot item level is not configurable: Blizzard never raised the item level of an
#        existing raid, so each raid keeps its values for good. They are set per map in
#        LootMgr.cpp and listed below, under ItemLevel.MythicPlus.Cap.

#ItemLevel.Dungeon.Normal = 805
#ItemLevel.Dungeon.Heroic = 825
#ItemLevel.Dungeon.Mythic = 840
#ItemLevel.MythicPlus.Base = 840

#
#    ItemLevel.MythicPlus.Cap
#        Item level cap of Mythic+ end-of-run loot. Everything else follows from it:
#          - the weekly chest is capped 5 points higher;
#          - the loot key (Challenge.LevelMax) is the one reaching this cap. As on retail, keys
#            can go higher (Challenge.LevelLimit): harder, for no better loot.
#
#        Leave it commented out: the value follows Game.Patch and Mythic+ opens with the tier, as
#        soon as the raid is out, without waiting for its difficulties. End-of-run loot stays
#        five below the heroic raid of the tier, the weekly chest reaches it, and the mythic raid
#        always keeps the lead.
#
#          Tier    Raid                    End of run   Chest   Loot key
#          7.0     Emerald Nightmare       860          865     +8
#          7.1     Trial of Valor          870          875     +11
#          7.1.5   The Nighthold           885          890     +14
#          7.2     Tomb of Sargeras        910          915     +19
#          7.3     Antorus                 940          945     +25
#
#        Optional brake: a lower value holds Mythic+ back (chest and max key included), for
#        instance to keep it at the previous tier during the first weeks of a raid. Loot key
#        obtained: 840 -> +1, 860 -> +8, 870 -> +11, 885 -> +14, 910 -> +19.
#
#        Raid item levels, for reference:
#          Raid                        Patch    LFR   Normal   Heroic   Mythic
#          The Emerald Nightmare       7.0      835    850      865      880
#          Trial of Valor              7.1      845    860      875      890
#          The Nighthold               7.1.5    860    875      890      905
#          Tomb of Sargeras            7.2      885    900      915      930
#          Antorus, the Burning Throne 7.3      915    930      945      960
#        The last boss gives more: +5 for Helya and Gul'dan, +10 for Kil'jaeden and Argus.
#        The first three bosses of The Nighthold give 5 less than the others.

#ItemLevel.MythicPlus.Cap = 860

#
#    ItemLevel.MythicPlus.WeeklyCap
#        Weekly chest cap. Leave it commented out: it is ItemLevel.MythicPlus.Cap plus 5, so it
#        follows the table above on its own. Set it only to depart from it.

#ItemLevel.MythicPlus.WeeklyCap = 865

#
#    Challenge.LevelMax
#        Loot key: loot no longer rises above it. Leave it unset: it follows
#        ItemLevel.MythicPlus.Cap (the "Loot key" column above), from +8 in 7.0 to +25 in 7.3.
#
#    Challenge.LevelLimit
#        Highest level a keystone can be upgraded to by a timed run. As on retail, keys can go
#        above the loot key: creatures keep getting stronger, loot no longer rises, and the best
#        groups go the furthest.
#        Default: 255, no practical limit (the most a key level can hold)
#
#    Damage.Variance.Pct
#        Random spread applied to every hit, either side of its computed value, in percent.
#        It covers players and creatures alike, in PvE and in PvP: two identical casts on the
#        same target should not land on the same number. This is on top of the weapon's own
#        min/max damage, which only spreads weapon swings.
#        Set to 0 to turn it off and make every hit deterministic again.
#        Default: 5.
#
#    Challenge.BaseKeyScaling
#        Creature health and damage increase, in percent compounded per key level, up to +15,
#        counted as the original game did: a +N key is worth (1 + slope)^(N-1), so +2 is already
#        8% harder than mythic 0. The original game rose by 8% at the Legion launch and by 10%
#        from 7.2.5; the tables shipped with the client are the end-of-expansion ones. A realm
#        reopening Legion from the start is therefore better served by the lower slope: 8% gives
#        2.00x at +10 and 2.94x at +15 (the 7.0 values) where 10% gives 2.36x and 3.80x.
#        Default: 8.
#
#    Challenge.HighKeyScaling
#        The same, above +15. The original game stopped rewarding those keys, so its slope
#        could run away without consequence; here they still drop loot, so they have to stay
#        beatable.
#        Worth knowing before changing it: between +15 and +25 a player gains fifty item levels
#        at most (895 to 945), roughly 55% of power. At 5% the difficulty rises 63% over the same
#        band, so a +25 is barely harder than a +15 once geared for it; 6% makes it 14% harder,
#        7% 26%. With a base of 8%, a +25 is worth 4.78x at 5%, 5.26x at 6% and 6.34x at 8%.
#        Default: 5.

#
#    Artifact.Knowledge.Start
#        Artifact Knowledge rank granted at server startup.
#        Since the return to the "launch" system (7.0), this value only initializes worldstate
#        20023: there is no automatic weekly increase anymore, and the Knowledge of players is
#        no longer forced to this value at login.
#        Default: depends on Game.Patch - 0 (7.0/7.1/7.1.5), 25 (7.2), 40 (7.3)

Artifact.Knowledge.Start = 1

#
#    Artifact.Knowledge.Cap
#        Highest Artifact Knowledge rank that can be reached, all sources combined (class hall
#        research work orders, Knowledge books). Also used as the cap of currency 1171.
#        Default: depends on Game.Patch - 25 (7.0/7.1/7.1.5), 40 (7.2), 55 (7.3)

#Artifact.Knowledge.Cap = 55

#
#    Artifact.Knowledge.BookLoot.Enable
#        Lets the Knowledge book drop (item 146745, +1 rank on use) from Legion raid bosses, the
#        Mythic+ chests (end of run and weekly) and the PvP victory chests. Independent from
#        Game.Patch.
#        A player gets one per week at most, all sources together.
#        Needs sql/old/world/2026_08_28_00_artifact_knowledge_rework.sql
#        Default: 1 (on)

Artifact.Knowledge.BookLoot.Enable = 1

#
###################################################################################################

###################################################################################################
# RAID OPENING
#
#    Raid.<Raid>.LFR.Wing<N>, Raid.<Raid>.Normal, Raid.<Raid>.Heroic, Raid.<Raid>.Mythic
#        Each difficulty and each Raid Finder wing opens on its own, independently from
#        Game.Patch.
#            1 - open
#            0 - closed
#        Adds to the `disables` table: a raid is closed as soon as either one closes it.
#        Players already inside the raid are not moved out. Read at startup.
#        Default: 1

# The Emerald Nightmare
Raid.EmeraldNightmare.LFR.Wing1 = 1
Raid.EmeraldNightmare.LFR.Wing2 = 1
Raid.EmeraldNightmare.LFR.Wing3 = 1
Raid.EmeraldNightmare.Normal = 1
Raid.EmeraldNightmare.Heroic = 1
Raid.EmeraldNightmare.Mythic = 1

# Trial of Valor
Raid.TrialOfValor.LFR.Wing1 = 1
Raid.TrialOfValor.Normal = 1
Raid.TrialOfValor.Heroic = 1
Raid.TrialOfValor.Mythic = 1

# The Nighthold
Raid.Nighthold.LFR.Wing1 = 1
Raid.Nighthold.LFR.Wing2 = 1
Raid.Nighthold.LFR.Wing3 = 1
Raid.Nighthold.LFR.Wing4 = 1
Raid.Nighthold.Normal = 1
Raid.Nighthold.Heroic = 1
Raid.Nighthold.Mythic = 1

# Tomb of Sargeras
Raid.TombOfSargeras.LFR.Wing1 = 1
Raid.TombOfSargeras.LFR.Wing2 = 1
Raid.TombOfSargeras.LFR.Wing3 = 1
Raid.TombOfSargeras.LFR.Wing4 = 1
Raid.TombOfSargeras.Normal = 1
Raid.TombOfSargeras.Heroic = 1
Raid.TombOfSargeras.Mythic = 1

# Antorus, the Burning Throne
Raid.Antorus.LFR.Wing1 = 1
Raid.Antorus.LFR.Wing2 = 1
Raid.Antorus.LFR.Wing3 = 1
Raid.Antorus.LFR.Wing4 = 1
Raid.Antorus.Normal = 1
Raid.Antorus.Heroic = 1
Raid.Antorus.Mythic = 1

#
###################################################################################################

###################################################################################################
# CONNECTIONS AND DIRECTORIES
#
#    RealmID
#        ID of the realm using this configuration.
#        Important: Must match the realm entry in the realmlist table of the auth database.
#        Default: 1

RealmID = 1

#
#    DataDir
#        Directory of the data extracted from the client (maps, vmaps, mmaps, dbc).
#        Important: Must be quoted, as the path might contain space characters.
#        Example: "C:/LegionCore/ClientData"
#        Default: "./ClientData"

DataDir = "./ClientData"

#
#    LogsDir
#        Logs directory.
#        Important: The directory must exist, or log files will not be created.
#        Default: "./Data/Logs"

LogsDir = "./Data/Logs"

#
#    LoginDatabaseInfo
#    CharacterDatabaseInfo
#    HotfixDatabaseInfo
#    WorldDatabaseInfo
#        Database connection settings for the MySQL server.
#        Format:  "hostname;port;username;password;database"
#        Example: ".;somenumber;user;pass;db" - (Named pipes on Windows,
#                  add "enable-named-pipe" to [mysqld] in my.ini)
#
#        Default: "127.0.0.1;3306;root;admin;auth"       - (LoginDatabaseInfo)
#                 "127.0.0.1;3306;root;admin;characters" - (CharacterDatabaseInfo)
#                 "127.0.0.1;3306;root;admin;hotfixes"   - (HotfixDatabaseInfo)
#                 "127.0.0.1;3306;root;admin;world"      - (WorldDatabaseInfo)

LoginDatabaseInfo     = "127.0.0.1;3306;root;admin;auth"
CharacterDatabaseInfo = "127.0.0.1;3306;root;admin;characters"
HotfixDatabaseInfo    = "127.0.0.1;3306;root;admin;hotfixes"
WorldDatabaseInfo     = "127.0.0.1;3306;root;admin;world"

#
#    LoginDatabase.WorkerThreads
#    CharacterDatabase.WorkerThreads
#    HotfixDatabase.WorkerThreads
#    WorldDatabase.WorkerThreads
#        The amount of worker threads spawned to handle asynchronous (delayed) MySQL
#        statements. Each worker thread has its own connection to the MySQL server.
#        Default: 1

LoginDatabase.WorkerThreads     = 1
CharacterDatabase.WorkerThreads = 1
HotfixDatabase.WorkerThreads    = 1
WorldDatabase.WorkerThreads     = 1

#
#    LoginDatabase.SynchThreads
#    CharacterDatabase.SynchThreads
#    HotfixDatabase.SynchThreads
#    WorldDatabase.SynchThreads
#        The amount of MySQL connections spawned to handle synchronous (blocking) queries.
#        Default: 1

LoginDatabase.SynchThreads     = 1
CharacterDatabase.SynchThreads = 1
HotfixDatabase.SynchThreads    = 1
WorldDatabase.SynchThreads     = 1

#
#    MaxPingTime
#        Time (in minutes) between MySQL keep-alive pings.
#        Default: 30

MaxPingTime = 30

#
#    WorldServerPort
#        Main TCP port to reach the world server.
#        Default: 8085

WorldServerPort = 8085

#
#    InstanceServerPort
#        TCP port for the second world connection (instances).
#        Default: 8086

InstanceServerPort = 8086

#
#    BnetServer.Address
#        IP address of the Battle.net server to connect to.
#        Default: 127.0.0.1

BnetServer.Address = 127.0.0.1

#
#    BnetServer.Port
#        Battle.net server port.
#        Default: 1118

BnetServer.Port = 1118

#
#    BindIP
#        Bind the world server to this IP address.
#        Default: "0.0.0.0" - (Bind to all interfaces)

BindIP = "0.0.0.0"

#
#    ThreadPool
#        Number of threads to be used for the global thread pool. It is used for:
#        - Signal handling
#        - Remote access (RA)
#        - Database keep-alive ping
#        - Core freeze check
#        - World socket networking
#        Default: 2

ThreadPool = 2

#
#    SourceDirectory
#        The path to your LegionCore source directory.
#        If the path is left empty, the built-in CMAKE_SOURCE_DIR is used.
#        Default: ""

SourceDirectory = ""

#
#    MySQLExecutable
#        The path to your mysql command line client binary.
#        Used to apply SQL updates automatically.
#        If the path is left empty, the built-in path from cmake is used.
#        Example: "C:/Program Files/MySQL/MySQL Server 8.4/bin/mysql.exe"
#        Default: ""

MySQLExecutable = ""

#
###################################################################################################

###################################################################################################
# SERVER SETTINGS
#
#    GameType
#        Server realm type.
#        Default: 0  - (NORMAL)
#                 1  - (PVP)
#                 6  - (RP)
#                 8  - (RPPVP)
#                 16 - (FFA_PVP, free-for-all PvP everywhere except rest areas and sanctuaries)

GameType = 0

#
#    RealmZone
#        Server realm zone. Sets the alphabet allowed in names.
#        Default: 1  - (Development   - any language)
#                 2  - (United States - extended-Latin)
#                 8  - (English       - extended-Latin)
#                 9  - (German        - extended-Latin)
#                 10 - (French        - extended-Latin)
#                 11 - (Spanish       - extended-Latin)
#                 12 - (Russian       - Cyrillic)

RealmZone = 1

#
#    StrictPlayerNames
#        Limits player names to the character set of the server language.
#        Prevents character creation and forces a rename if disallowed characters are used.
#        Default: 0 - (Disabled, client check depending on the server timezone)
#                 1 - (Enabled, strictly basic Latin characters)
#                 2 - (Enabled, strictly realm zone specific, see RealmZone)
#                 3 - (Enabled, basic Latin characters + realm zone specific)

StrictPlayerNames = 1

#
#    StrictCharterNames
#        Limits guild charter names to the language specific character set.
#        Default: 0 - (Disabled)
#                 1 - (Strictly basic Latin characters)
#                 2 - (Realm zone specific)
#                 3 - (Basic Latin characters + realm zone specific)

StrictCharterNames = 1

#
#    StrictPetNames
#        Limits pet names to the language specific character set.
#        Default: 0 - (Disabled)
#                 1 - (Strictly basic Latin characters)
#                 2 - (Realm zone specific)
#                 3 - (Basic Latin characters + realm zone specific)

StrictPetNames = 1

#
#    DBC.Locale
#        Language of the DBC/DB2 files used by the server.
#        Default: 0 - (English)
#                 1 - (Korean)
#                 2 - (French)
#                 3 - (German)
#                 4 - (Chinese)
#                 5 - (Taiwanese)
#                 6 - (Spanish)
#                 7 - (Spanish Mexico)
#                 8 - (Russian)

DBC.Locale = 0

#
#    DeclinedNames
#        Allows Russian clients to set and use declined names (grammatical declensions).
#        Default: 0 - (Disabled, except when RealmZone is Russian)
#                 1 - (Enabled)

DeclinedNames = 0

#
#    Expansion
#        Highest expansion supported by the server.
#        Controls the available maps, races and classes.
#        Default: 6 - (Legion)
#                 5 - (Warlords of Draenor)
#                 4 - (Mists of Pandaria)
#                 3 - (Cataclysm)
#                 2 - (Wrath of the Lich King)
#                 1 - (Burning Crusade)
#                 0 - (Classic, ignores all expansion content)

Expansion = 6

#
#    MinPlayerName
#        Minimal player name length.
#        Range: 1-12
#        Default: 2

MinPlayerName = 2

#
#    MinCharterName
#        Minimal guild charter name length.
#        Range: 1-24
#        Default: 2

MinCharterName = 2

#
#    MinPetName
#        Minimal pet name length.
#        Range: 1-12
#        Default: 2

MinPetName = 2

#
#    MaxWhoListReturns
#        Maximum number of players returned in the /who list.
#        Default: 49

MaxWhoListReturns = 49

#
#    CharactersPerAccount
#        Limits the number of characters per account on all realms.
#        Important: Must be >= CharactersPerRealm.
#        Default: 50

CharactersPerAccount = 50

#
#    CharactersPerRealm
#        Limits the number of characters per account on this realm.
#        Range: 1-12
#        Default: 12 - (Client limit)

CharactersPerRealm = 12

#
#    DemonHuntersPerRealm
#        Limits the number of Demon Hunters per account on this realm.
#        Range: 1-12
#        Default: 1

DemonHuntersPerRealm = 12

#
#    CharacterCreating.MinLevelForDemonHunter
#        Minimum level of an existing character on the account required to create
#        a Demon Hunter.
#        Default: 70 - (Requires a level 70 character)
#                 0  - (No restriction)

CharacterCreating.MinLevelForDemonHunter = 0

#
#    SkipCinematics
#        Disables the intro cinematic at first login.
#        Useful when custom start location coordinates are used.
#        Default: 0 - (Show intro for each new character)
#                 1 - (Show intro only for the first character of this race)
#                 2 - (Disable intro for all classes)

SkipCinematics = 0

#
#    MaxPlayerLevel
#        Maximum level that can be reached by players.
#        Range: 1-255
#        Default: 110

MaxPlayerLevel = 110

#
#    StartPlayerLevel
#        Starting level for new characters.
#        Range: 1-MaxPlayerLevel
#        Default: 1

StartPlayerLevel = 1

#
#    StartHeroicPlayerLevel
#        Starting level for heroic classes (Death Knight).
#        Range: 1-MaxPlayerLevel
#        Default: 55

StartHeroicPlayerLevel = 55

#
#    StartPlayerMoney
#        Amount of money (in copper) a character has after creation.
#        Default: 0
#                 100 - (1 silver)

StartPlayerMoney = 0

#
#    InstantLogout
#        Required security level for instantly logging out everywhere.
#        Does not work while in combat, dueling or falling.
#        Default: 1 - (Moderators/GMs/Admins)
#                 0 - (Everyone)
#                 2 - (GMs/Admins)
#                 3 - (Admins only)
#                 4 - (Disabled, nobody)

InstantLogout = 0

#
#    NoResetTalentsCost
#        Resetting talents does not cost any gold.
#        Note: In Legion, talents are free by default anyway.
#        Default: 0 - (Disabled, normal cost)
#                 1 - (Enabled, free)

NoResetTalentsCost = 1

#
#    PlayerDump.DisallowPaths
#        Disallows using paths in PlayerDump output files.
#        Security: prevents writing into arbitrary directories.
#        Default: 1

PlayerDump.DisallowPaths = 1

#
#    PlayerDump.DisallowOverwrite
#        Disallows overwriting existing files with PlayerDump.
#        Default: 1

PlayerDump.DisallowOverwrite = 1

#
#    DisableWaterBreath
#        Required security level for unlimited water breathing.
#        Default: 4 - (Disabled for everyone)
#                 0 - (Enabled for everyone)
#                 1 - (Moderators/GMs/Admins)
#                 2 - (GMs/Admins)
#                 3 - (Admins only)

DisableWaterBreath = 1

#
#    FastFishing
#        Speeds up fishing or removes the wait completely.
#        Default: 0 - (Normal)
#                 1 - (Faster)
#                 2 - (Instant)

FastFishing = 0

#
#    PlayerStart.AllReputation
#        New characters start with most of the high level reputations
#        needed for items, mounts, etc.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

PlayerStart.AllReputation = 0

#
#    DungeonFinder.DebugJoin
#        Allows using the Dungeon Finder with a single player.
#        Useful for development/testing, not recommended in production.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

DungeonFinder.DebugJoin = 1

#
#    Bpay.Enabled
#        Enables the in-game shop button (BattlePay).
#        Requires data in the battlepay table.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Bpay.Enabled = 1

#
#    BattlePay.CurrencyID
#        Currency symbol shown in the in-game shop.
#        Default: 4 - (EUR, euro sign)
#                 1 - (USD, $)
#                 2 - (GBP, pound sign)
#                 3 - (KRW, won sign)
#
BattlePay.CurrencyID = 4

#
#    CharacterBoost.Enabled
#        Enables the Character Boost from the BattlePay shop.
#        Lets players buy level 90/100/110 boosts.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

CharacterBoost.Enabled = 1

#
#    ClassTrial.Enabled
#        Enables the Class Trial button on the character selection screen.
#        Creates a temporary level 100 character that is locked
#        after logout until a Boost is bought.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

ClassTrial.Enabled = 1

#
#    CharacterTemplate.Enabled
#        Enables character templates on the character creation screen.
#        When enabled, every template defined in character_template
#        is available. Players can create pre-equipped characters
#        at predefined levels (90, 100, 110, etc.).
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

CharacterTemplate.Enabled = 0

#
#    WowToken.Enabled
#        Enables the WoW Token system in the auction house.
#        Lets players buy/sell tokens and
#        redeem them for BattlePay balance.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

WowToken.Enabled = 0

#
#    WowToken.MarketPrice
#        WoW Token price in gold.
#        Default: 60000

WowToken.MarketPrice = 60000

#
#    WowToken.RedeemBalanceAmount
#        BattlePay balance added when a token is redeemed.
#        Default: 50

WowToken.RedeemBalanceAmount = 1000

#
#    WowToken.ItemId
#        Item ID of the WoW Token in the database.
#        Default: 122284

WowToken.ItemId = 122284

#
#    Custom.GainHonorOnGuardKill
#        Grants honor for killing a city guard.
#        Note: Only the guards of capitals and major cities
#        are flagged as granting honor in the database.
#        Default: 0 - (No honor)
#                 1 - (Honor granted)

Custom.GainHonorOnGuardKill = 0

#
#    Custom.GainHonorOnEliteKill
#        Grants honor for killing an elite creature (non-elite rares excluded).
#        Default: 0 - (No honor)
#                 1 - (Honor granted)

Custom.GainHonorOnEliteKill = 0

#
#    Player.ControlGuardianPets
#        Uncontrolled temporary pets (e.g. Dire Beast) automatically attack
#        the player's target when the player changes target.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Player.ControlGuardianPets = 1

#
#    Player.UnlimitedLegionLegendaries
#        Removes the limit on equipped Legion legendaries.
#        Allows equipping any number of legendaries at the same time.
#        Default: 0 - (Disabled, blizzlike limit of 2)
#                 1 - (Enabled, unlimited)

Player.UnlimitedLegionLegendaries = 1

#
#    DisableRestart
#        Disables the automatic daily server restart.
#        Default: 1 - (Automatic restart disabled)
#                 0 - (Automatic restart every day)

DisableRestart = 1

#
#    WorldQuest
#        Enables/disables the World Quest system.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

WorldQuest = 1

#
#    AllFlightPaths
#        Characters know all flight paths (of both factions) after creation.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

AllFlightPaths = 0

#
#    InstantFlightPaths
#        Flights from flight masters are instant (teleport instead of flying).
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

InstantFlightPaths = 0

#
#    WeeklyReset.Day
#    WeeklyReset.Hour
#        Day and hour of the weekly reset, in the local time of the machine running the server:
#        weekly quests, currency caps, raid lockouts and Mythic+ keys reset together.
#        Day: 0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday, 5 = Friday,
#        6 = Saturday. Hour: 0 to 23.
#        Takes effect on restart: the next reset moves to the new slot without firing one at once.
#        Default: 2 (Tuesday) and 19

WeeklyReset.Day = 2
WeeklyReset.Hour = 19

#
#    Instance.IgnoreLevel
#        Ignores the level requirement when entering instances.
#        Default: 0 - (Disabled, level required)
#                 1 - (Enabled, any level accepted)

Instance.IgnoreLevel = 1

#
#    Instance.IgnoreRaid
#        Ignores the raid group requirement when entering raids.
#        Default: 0 - (Disabled, raid group required)
#                 1 - (Enabled, solo entry possible)

Instance.IgnoreRaid = 1

#
#    Quests.LowLevelHideDiff
#        Level difference between player and quest from which
#        low level quests are no longer shown (no exclamation mark).
#        Default: 4  - (Hide quests 4 or more levels below)
#                 -1 - (Disabled, show all quests)

Quests.LowLevelHideDiff = -1

#
#    Quests.HighLevelHideDiff
#        Level difference between player and quest from which
#        high level quests are no longer shown.
#        Default: 7  - (Hide quests 7 or more levels above)
#                 -1 - (Disabled, show all quests)

Quests.HighLevelHideDiff = -1

#
#    Quests.IgnoreRaid
#        Allows non-raid quests to be completed while in a raid group.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Quests.IgnoreRaid = 0

#
#    Quests.IgnoreAutoAccept
#        Ignores the quest auto-accept flag.
#        Players have to accept every quest manually.
#        Default: 0 - (Disabled, DB values apply)
#                 1 - (Enabled, manual acceptance required)

Quests.IgnoreAutoAccept = 0

#
#    Quests.IgnoreAutoComplete
#        Ignores the quest auto-complete flag.
#        Players have to turn in every quest manually.
#        Default: 0 - (Disabled, DB values apply)
#                 1 - (Enabled, manual turn-in required)

Quests.IgnoreAutoComplete = 0

#
#    MaxPrimaryTradeSkill
#        Maximum number of primary professions a character can learn.
#        Range: 0-10
#        Default: 2

MaxPrimaryTradeSkill = 2

#
#    MinPetitionSigns
#        Number of signatures required on a charter to create a guild.
#        Range: 0-4
#        Default: 4

MinPetitionSigns = 0

#
#    MailDeliveryDelay
#        Time (in seconds) mail delivery is delayed when sending items.
#        Default: 3600 - (1 hour)

MailDeliveryDelay = 3600

#
#    ClientCacheVersion
#        Client cache version, used to force a client side cache reset.
#        Use a value different from the one in the DB to force the reset.
#        Default: 0 - (Use the value from world DB db_version.cache_id)

ClientCacheVersion = 0

#
#    HotfixCacheVersion
#        Hotfix cache version, used to force a client side hotfix cache reset.
#        Default: 0 - (Use the value from world DB version.hotfix_id)

HotfixCacheVersion = 0

#
#    Event.Announce
#        Announces seasonal events in the chat when they start.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Event.Announce = 0

#
#    BeepAtStart
#        Beeps when the world server has finished starting (Linux/Unix).
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

BeepAtStart = 1

#
#    PlayerStart.String
#        Message displayed at the first login of a newly created character.
#        Default: "" - (Disabled)

PlayerStart.String = ""

#
#    Motd
#        Message of the Day, displayed at each player login.
#        Use '@' for a newline.
#        Escape special characters with '\'.
#        Example: "Welcome to John\'s server@Have a nice adventure!"
#        Default: "Welcome to a Trinity Core server."

Motd = "Welcome to a LegionCore Server."

#
#    Server.LoginInfo
#        Displays the core version information (.server info) at login.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Server.LoginInfo = 0

#
#    Command.LookupMaxResults
#        Maximum number of results displayed by the .lookup commands.
#        Default: 0 - (Unlimited)

Command.LookupMaxResults = 1000

#
#    PlayerCommand.AuraScan
#        Player command `_scan`: shows every aura of the selected unit, hidden ones included,
#        with their amounts and durations. Reveals the hidden mechanics of bosses and players.
#            0 - disabled
#            1 - enabled
#        Default: 0

PlayerCommand.AuraScan = 0

#
#    AllowTickets
#        Allows/disallows sending new support tickets.
#        Default: 1 - (Allowed)
#                 0 - (Disallowed)

AllowTickets = 1

#
#    DBC.EnforceItemAttributes
#        Forces the use of item attributes from the DBC files
#        instead of the ones from the database.
#        Default: 1 - (Enabled, DBC takes priority)
#                 0 - (Disabled, DB values take priority)

DBC.EnforceItemAttributes = 1

#
#    AccountInstancesPerHour
#        Different instances an account can enter per hour, outside the dungeon finder; going back
#        into an instance already counted is always allowed. 0 = no limit.
#        Default: 10 (as on retail)

AccountInstancesPerHour = 10

#
#    MaxAccountsOnline
#        Maximum number of accounts logged in at the same time.
#        Additional logins are put in the login queue.
#        Default: 1000

MaxAccountsOnline = 1000

