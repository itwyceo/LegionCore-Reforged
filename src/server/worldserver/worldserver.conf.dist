###################################################################################################

###################################################################################################
###################################################################################################
#                                                                                                 #
#                                  SERVER TECHNICAL CONFIGURATION                                 #
#                                                                                                 #
###################################################################################################
###################################################################################################

###################################################################################################
# NETWORK CONFIGURATION
#
#    Network.Threads
#        Number of network threads.
#        Recommended: 1 thread per 1000 connections.
#        Default: 1

Network.Threads = 1

#
#    Network.OutKBuff
#        Size (in bytes) of the kernel output buffer (SO_SNDBUF).
#        Default: -1 - (Use the system default)

Network.OutKBuff = -1

#
#    Network.OutUBuff
#        Size (in bytes) of the user space output buffer, per connection.
#        Default: 65536

Network.OutUBuff = 65536

#
#    Network.TcpNodelay
#        TCP Nagle algorithm setting.
#        Default: 0 - (Enabled, less traffic, more latency)
#                 1 - (Disabled, more traffic, less latency, TCP_NO_DELAY)

Network.TcpNodelay = 1

#
###################################################################################################

###################################################################################################
# CONSOLE AND REMOTE ACCESS
#
#    Console.Enable
#        Enables the server command console.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Console.Enable = 1

#
#    Ra.Enable
#        Enables the remote console (telnet).
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Ra.Enable = 0

#
#    Ra.IP
#        Bind remote access to this IP address.
#        Default: "127.0.0.1" - (This machine only)
#                 "0.0.0.0"   - (All interfaces)

Ra.IP = "127.0.0.1"

#
#    Ra.Port
#        TCP port to reach the remote console.
#        Default: 3443

Ra.Port = 3443

#
#    RA.MinLevel
#        Required security level to use the remote console.
#        Default: 3 - (Administrator)

RA.MinLevel = 3

#
#    SOAP.Enabled
#        Enables the SOAP service (web API for remote commands).
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

SOAP.Enabled = 0

#
#    SOAP.IP
#        Bind the SOAP service to this IP address.
#        Default: "127.0.0.1" - (Localhost only)

SOAP.IP = "127.0.0.1"

#
#    SOAP.Port
#        TCP port to reach the SOAP service.
#        Default: 7878

SOAP.Port = 7878

#
###################################################################################################

###################################################################################################
# PERFORMANCE
#
#    UseProcessors
#        Processor mask for multi-processor systems (Windows).
#        Default: 0 - (Selected by the OS)

UseProcessors = 0

#
#    ProcessPriority
#        Server process priority.
#        Linux: nice value of -15 (requires root).
#        Windows: HIGH priority class process.
#        Default: 0 - (Normal)
#                 1 - (High)

ProcessPriority = 0

#
#    Compression
#        Compression level of the packets sent to the client.
#        Range: 1-9
#        Default: 1 - (Speed)
#                 9 - (Best compression)

Compression = 1

#
#    SaveRespawnTimeImmediately
#        Saves the respawn time of creatures at death
#        and of game objects at use.
#        Default: 1 - (Enabled, saved immediately)
#                 0 - (Disabled, saved when the grid is unloaded)

SaveRespawnTimeImmediately = 1

#
#    MaxOverspeedPings
#        Maximum number of overspeed pings before the player is disconnected.
#        Default: 0  - (Disabled)
#                 2  - (Enabled, minimum)
#                 3+ - (Enabled, more tolerant)

MaxOverspeedPings = 0

#
#    GridUnload
#        Unloads map grids to save memory.
#        Disable it if enough RAM is available, to speed up
#        zone transitions for players.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

GridUnload = 1

#
#    SocketTimeOutTime
#        Time (in milliseconds) after which an idle session
#        on the character selection screen is disconnected.
#        Default: 900000 - (15 minutes)

SocketTimeOutTime = 900000

#
#    SessionAddDelay
#        Time (in microseconds) after authentication before the connection
#        is added to the world sessions. Avoids concurrency issues.
#        Default: 10000 - (10 milliseconds)

SessionAddDelay = 10000

#
#    GridCleanUpDelay
#        Time (in milliseconds) before inactive grids are cleaned up.
#        Default: 300000 - (5 minutes)

GridCleanUpDelay = 300000

#
#    MapUpdateInterval
#        Time (in milliseconds) between map updates.
#        This is the main "tick" of the world server.
#        Default: 100 - (0.1 second)

MapUpdateInterval = 100

#
#    ChangeWeatherInterval
#        Time (in milliseconds) between weather updates.
#        Default: 600000 - (10 minutes)

ChangeWeatherInterval = 600000

#
#    PlayerSaveInterval
#        Time (in milliseconds) between automatic player saves.
#        Default: 90000 - (90 seconds)

PlayerSaveInterval = 90000

#
#    mmap.enablePathFinding
#        Enables pathfinding using MMAPs (navmesh).
#        Recommended for smart creature movement.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

mmap.enablePathFinding = 1

#
#    vmap.enableLOS
#    vmap.enableHeight
#        VMap support for line of sight (LOS) and height calculation.
#        Required for correct creature and spell behavior.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

vmap.enableLOS    = 1
vmap.enableHeight = 1

#
#    vmap.petLOS
#        Line of sight check for pets,
#        prevents attacks through walls.
#        Default: 1 - (Enabled)
#                 0 - (Disabled, less CPU usage)

vmap.petLOS = 1

#
#    vmap.enableIndoorCheck
#        VMap based indoor/outdoor detection.
#        Removes outdoor-only auras (mounts, etc.) when indoors.
#        Default: 1 - (Enabled)
#                 0 - (Disabled, less CPU usage)

vmap.enableIndoorCheck = 1

#
#    DetectPosCollision
#        Checks final movement positions, summon positions, etc. for collisions
#        with objects and walls (walls only if vmaps are enabled).
#        Default: 1 - (Enabled)
#                 0 - (Disabled, less precise but less CPU usage)

DetectPosCollision = 1

#
#    TargetPosRecalculateRange
#        Maximum distance between the movement target point and the target object
#        before the path is recalculated.
#        Range: 0.5-5.0
#        Default: 1.5
#                 0.5 - (Contact range, more sensitive to target movement)
#                 5.0 - (Melee range, less CPU usage)

TargetPosRecalculateRange = 1.5

#
#    UpdateUptimeInterval
#        Time (in minutes) between updates of the realm uptime
#        in the auth database.
#        Default: 10

UpdateUptimeInterval = 10

#
#    MaxCoreStuckTime
#        Time (in seconds) before the server is forced to crash if it is frozen.
#        Default: 0   - (Disabled)
#                 10+ - (Enabled, 10+ recommended)

MaxCoreStuckTime = 0

#
#    MaxMapStuckTime
#        Time (in seconds) before a frozen map is forcibly restarted.
#        Default: 0   - (Disabled)
#                 10+ - (Enabled, 10+ recommended)

MaxMapStuckTime = 0

#
#    AddonChannel
#        Enables the addon communication channel through the server.
#        Some addons will not work without this channel.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

AddonChannel = 1

#
#    MapUpdate.Threads
#        Number of threads used to update maps.
#        Default: 1

MapUpdate.Threads = 1

#
#    CleanCharacterDB
#        Cleans deprecated achievements, skills, spells and talents
#        out of the characters database at startup.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

CleanCharacterDB = 0

#
#    ResetCharacterDB
#        Deletes ALL character data, account progress,
#        guilds, mail, auctions and related data at server startup.
#        Useful after a PTR test phase.
#        WARNING: This cannot be undone! Set it back to 0 after the reset.
#        Default: 0 - (Disabled)
#                 1 - (Enabled, deletes everything at the next startup)

ResetCharacterDB = 0

#
#    PersistentCharacterCleanFlags
#        Determines which clean flags remain set after a cleanup.
#        This is a bitmask (see /doc/CharacterDBCleanup.txt).
#        Example: 14 - (Skill, talent and spell cleanups remain enabled)
#        Default: 0  - (All cleanups are disabled after running)

PersistentCharacterCleanFlags = 0

#
###################################################################################################

###################################################################################################
# SERVER PROCESS
#
#    PidFile
#        PID file of the world server process (for management scripts).
#        Example: "./world.pid"
#        Default: "" - (Disabled)

PidFile = ""

