Rate.Reputation.LowLevel.Quest = 1

#
#    RecruitAFriend.Enable
#        Master switch for the Recruit-A-Friend system: invitations, the +50% experience and
#        reputation bonus, and the in-chat reminders.
#        The 7.3.5 client can SEND an invitation but has no interface to answer one, so a
#        recruit answers with the chat commands below.
#        Default: 1 (enabled)

RecruitAFriend.Enable = 1

#
#    RecruitAFriend.Commands.Enable
#        Enables .account raf list / accept / refuse, which show who sent an invitation along
#        with their note, and answer it. This is how a recruit answers, so turning it off
#        leaves invitations unanswerable. Ignored while RecruitAFriend.Enable is 0: the
#        commands only ever answer invitations, so they are pointless without the system.
#        Default: 1 (enabled)

RecruitAFriend.Commands.Enable = 1

#
#    RecruitAFriend.MaxLevel
#        Level above which a character stops earning the bonus, and stops earning grantable
#        levels. Checked per character, not per pair: once the recruiter passes it he loses
#        the bonus while his lower level recruit keeps it.
#        Default: 100

RecruitAFriend.MaxLevel = 100

#
#    RecruitAFriend.InviteExpireDays
#        How long an unanswered invitation stays valid, in days. Expired invitations are
#        dropped at the daily reset. 0 disables expiration.
#        Default: 7

RecruitAFriend.InviteExpireDays = 7

#
#    Rate.MoveSpeed
#        Multiplier for base movement speed.
#        Default: 1

Rate.MoveSpeed = 1

#
#    Rate.InstanceResetTime
#        Multiplier for the interval between raid/heroic instance resets.
#        Higher value = more time between resets. Lower value = less time.
#        Requires cleaning instance_reset in the characters database.
#        Default: 1

Rate.InstanceResetTime = 1

#
#    SkillGain.Crafting / SkillGain.Gathering
#        Multipliers for crafting and gathering skill gains.
#        Default: 1

SkillGain.Crafting  = 1
SkillGain.Gathering = 1

#
#    SkillChance.*
#        Chance (in %) to increase a skill depending on the recipe color.
#        Default: 100 - (Orange, guaranteed)
#                 75  - (Yellow, likely)
#                 25  - (Green, low)
#                 0   - (Grey, impossible)

SkillChance.Orange = 100
SkillChance.Yellow = 75
SkillChance.Green  = 25
SkillChance.Grey   = 0

#
#    SkillChance.MiningSteps / SkillChance.SkinningSteps
#        Progressive decrease of the skill gain chance for mining/skinning.
#        Default: 0  - (Disabled)
#                 75 - (Chance halved every 75 skill points)

SkillChance.MiningSteps   = 0
SkillChance.SkinningSteps = 0

#
#    DurabilityLoss.InPvP
#        Durability loss on death in PvP.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

DurabilityLoss.InPvP = 0

#
#    DurabilityLoss.OnDeath
#        Durability loss percentage on each death.
#        Default: 10

DurabilityLoss.OnDeath = 0

#
#    DurabilityLossChance.Damage
#        Chance to lose durability on an equipped item when taking damage.
#        Default: 0.5 - (100/0.5 = every 200 damage, 1 item loses durability)

DurabilityLossChance.Damage = 0.0000001

#
#    DurabilityLossChance.Absorb
#        Chance to lose durability on an armor piece when absorbing damage.
#        Default: 0.5 - (100/0.5 = every 200 damage absorbed)

DurabilityLossChance.Absorb = 0.0000001

#
#    DurabilityLossChance.Parry
#        Chance to lose durability on the main weapon when parrying an attack.
#        Default: 0.05 - (100/0.05 = every 2000 damage parried)

DurabilityLossChance.Parry = 0.0000001

#
#    DurabilityLossChance.Block
#        Chance to lose durability on the shield when blocking an attack.
#        Default: 0.05 - (100/0.05 = every 2000 damage blocked)

DurabilityLossChance.Block = 0.0000001

#
#    Death.SicknessLevel
#        Level from which resurrection sickness applies.
#        Example: 11 - (Levels 1-10 not affected,
#                       Levels 11-19 affected for 1 minute,
#                       Levels 20+ affected for 10 minutes)
#        Default: 11               - (See example)
#                 MaxPlayerLevel+1 - (Disabled)
#                 -10              - (All levels, 10 minutes)

Death.SicknessLevel = 11

#
#    Death.CorpseReclaimDelay.PvP / Death.CorpseReclaimDelay.PvE
#        Progressively increases the corpse reclaim delay
#        on repeated deaths (PvP/PvE).
#        Default: 1 - (Enabled, blizzlike behavior)
#                 0 - (Disabled, constant delay)

Death.CorpseReclaimDelay.PvP = 0
Death.CorpseReclaimDelay.PvE = 0

#
#    Death.Bones.World / Death.Bones.BattlegroundOrArena
#        Creates bones instead of a corpse on resurrection
#        (in normal zones/instances or in battlegrounds/arenas).
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Death.Bones.World               = 1
Death.Bones.BattlegroundOrArena = 1

#
###################################################################################################

###################################################################################################
# AUTO BROADCAST
#
#    AutoBroadcast.On
#        Enables periodic automatic broadcast messages.
#        Messages are defined in the autobroadcast table.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

AutoBroadcast.On = 0

#
#    AutoBroadcast.Center
#        Display method for automatic broadcasts.
#        Default: 0 - (Global announcement)
#                 1 - (Notification)
#                 2 - (Both)

AutoBroadcast.Center = 0

#
#    AutoBroadcast.Timer
#        Time (in milliseconds) between automatic broadcasts.
#        Default: 60000 - (60 seconds)

AutoBroadcast.Timer = 60000

#
###################################################################################################

###################################################################################################
# BATTLEGROUNDS
#
#    Battleground.CastDeserter
#        Casts the Deserter debuff on players who leave a battleground in progress.
#        Default: 1 - (Enabled)
#                 0 - (Disabled)

Battleground.CastDeserter = 1

#
#    Battleground.QueueAnnouncer.Enable
#        Announces the battleground queue status in the chat.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Battleground.QueueAnnouncer.Enable = 0

#
#    Battleground.QueueAnnouncer.PlayerOnly
#        Queue announcement type.
#        Default: 0 - (System message, visible to everyone)
#                 1 - (Private, visible only to queued players)

Battleground.QueueAnnouncer.PlayerOnly = 0

#
#    Battleground.InvitationType
#        Battleground invitation mode.
#        Default: 0 - (Normal, invite as many players as possible without balancing)
#                 1 - (Experimental, tries to balance the factions)

Battleground.InvitationType = 0

#
#    Battleground.PrematureFinishTimer
#        Time (in milliseconds) before a battleground ends prematurely
#        if a team does not have enough players.
#        Default: 300000 - (5 minutes)
#                 0      - (Disabled, not recommended)

Battleground.PrematureFinishTimer = 300000

#
#    Battleground.PremadeGroupWaitForMatch
#        Time (in milliseconds) a premade group waits for a matching
#        group of the opposing faction before entering.
#        Default: 1800000 - (30 minutes)
#                 0       - (Disabled)

Battleground.PremadeGroupWaitForMatch = 1800000

#
#    Battleground.GiveXPForKills
#        Gives experience for honorable kills in battlegrounds.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Battleground.GiveXPForKills = 0

#
#    Battleground.Random.ResetHour
#        Hour of the day when the random battleground reset occurs.
#        Range: 0-23
#        Default: 6 - (06:00)

Battleground.Random.ResetHour = 6

#
###################################################################################################

###################################################################################################
# OUTDOOR BATTLEFIELDS
#
#    Wintergrasp.Enable
#        Enables the Wintergrasp battlefield (WotLK content).
#        Default: 0 - (Disabled)
#                 1 - (Enabled, experimental)

Wintergrasp.Enable = 0

#
#    Wintergrasp.PlayerMax
#        Maximum number of players allowed in Wintergrasp.
#        Default: 100

Wintergrasp.PlayerMax = 100

#
#    Wintergrasp.PlayerMin
#        Minimum number of players required for Wintergrasp.
#        Default: 0

Wintergrasp.PlayerMin = 0

#
#    Wintergrasp.PlayerMinLvl
#        Minimum level required to take part in Wintergrasp.
#        Default: 77

Wintergrasp.PlayerMinLvl = 77

#
#    Wintergrasp.BattleTimer
#        Duration (in minutes) of a Wintergrasp battle.
#        Default: 30

Wintergrasp.BattleTimer = 30

#
#    Wintergrasp.NoBattleTimer
#        Time (in minutes) between Wintergrasp battles.
#        Default: 150

Wintergrasp.NoBattleTimer = 150

#
#    Wintergrasp.CrashRestartTimer
#        Time (in minutes) before Wintergrasp restarts if the world server
#        crashed during a running battle.
#        Default: 10

Wintergrasp.CrashRestartTimer = 10

#
#    TolBarad.Enable
#        Enables the Tol Barad battlefield (Cataclysm content).
#        Default: 0 - (Disabled)
#                 1 - (Enabled, experimental and unstable)

TolBarad.Enable = 0

#
#    TolBarad.PlayerMax / PlayerMin / PlayerMinLvl / BattleTimer / NoBattleTimer
#        Tol Barad settings (same as Wintergrasp).
#        Default: 100 / 0 / 85 / 15 / 150

TolBarad.PlayerMax = 100
TolBarad.PlayerMin = 0
TolBarad.PlayerMinLvl = 85
TolBarad.BattleTimer = 15
TolBarad.NoBattleTimer = 150

#
###################################################################################################

###################################################################################################
# ARENA
#
#    Arena.MaxRatingDifference
#        Maximum rating difference between two teams in rated matches.
#        Default: 150 - (Enabled)
#                 0   - (Disabled, no limit)

Arena.MaxRatingDifference = 150

#
#    Arena.RatingDiscardTimer
#        Time (in seconds) after which the rating difference is ignored
#        when looking for a match.
#        Default: 600 - (10 minutes)
#                 0   - (Disabled)

Arena.RatingDiscardTimer = 600

#
#    Arena.RatedUpdateTimer
#        Time (in milliseconds) between checks for rated arena matchups.
#        Default: 5000 - (5 seconds)

Arena.RatedUpdateTimer = 5000

#
#    Arena.QueueAnnouncer.Enable
#        Announces the arena queue status in the chat.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Arena.QueueAnnouncer.Enable = 0

#
#    Arena.ArenaSeason.InProgress
#        State of the current arena season.
#        Default: 1 - (In progress)
#                 0 - (Finished)

Arena.ArenaSeason.InProgress = 1

#
#    PvP.ActiveSeason
#        Current Legion PvP season. It sets the item level of all PvP loot (weekly chest, rated
#        and unrated end-of-match rewards) and what obliterating it gives.
#            0  no season
#            1  Legion Season 1 (7.0)          5  Legion Season 5 (7.3)
#            2  Legion Season 2 (7.1)          6  Legion Season 6 (7.3.2)
#            3  Legion Season 3 (7.2)          7  Legion Season 7 (7.3.5)
#            4  Legion Season 4 (7.2.5)
#        The client gets Blizzard's season number, 18 + N (19 to 25 for Seasons 1 to 7): it
#        replaces the former Arena.ArenaSeason.ID setting. A value above 7 falls back to 0.
#        Seasons of each tier, as on retail: 7.0 -> 1, 7.1 -> 1 then 2, 7.1.5 -> 2, 7.2 -> 3
#        then 4, 7.3 -> 5, 6 then 7.
#        When the season changes, the ratings of the old one are saved (table
#        character_brackets_info_season); the new one starts from zero, or gets its save back if it
#        was already played - going back from a season picked by mistake loses nothing.
#        GM commands, applied at the next start: .pvpseason info, reset (save then reset the
#        current season), restore (back to its save), cancel. A second reset in the same season
#        replaces the previous save.
#        Takes effect on restart; a config reload does not change the season.
#        Default: 0 - no season

PvP.ActiveSeason = 0

#
#    PvP.ActiveStep
#        The 2200 and 2400 rating steps: the top of the ladder gets a little more than the 2000
#        step. On retail they opened with the raid of the season: set 1 when that raid opens.
#            0  closed: loot stops at the 2000 step, elite gear included
#            1  open
#        Default: 0

PvP.ActiveStep = 0

#
#    PvP.LevelEnable
#        Turns on the per-season PvP item level described above. At 0, PvP loot takes the fixed
#        levels of the end of Legion (pvp_reward table), whatever the season.
#        Default: 1

PvP.LevelEnable = 1

#
#    Arena.ArenaStartMatchmakerRating
#        Starting matchmaker rating for new players.
#        Default: 1500

Arena.ArenaStartMatchmakerRating = 1500

#
###################################################################################################

###################################################################################################
# CHARACTER DELETION
#
#    CharDelete.Method
#        Character deletion behavior.
#        Default: 0 - (Completely remove the character from the database)
#                 1 - (Unlink the character from the account, free up the name,
#                      appears as deleted in game, can be restored)

CharDelete.Method = 0

#
#    CharDelete.MinLevel
#        Minimum level required to use the unlinking method.
#        Default: 0  - (Same method for every level)
#                 1+ - (Only characters of the given level or higher are unlinked)

CharDelete.MinLevel = 0

#
#    CharDelete.KeepDays
#        Time (in days) before unlinked characters are permanently deleted.
#        Default: 30 - (Enabled)
#                 0  - (Disabled, never delete)

CharDelete.KeepDays = 30

